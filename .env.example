POSTGRES_DB=agentforge
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge_local_only
POSTGRES_PORT=5432
CORE_PORT=8080
AGENT_PORT=8000
WEB_PORT=5173
REDIS_PORT=6379

AGENTFORGE_DB_URL=jdbc:postgresql://localhost:5432/agentforge
AGENTFORGE_DB_USERNAME=agentforge
AGENTFORGE_DB_PASSWORD=agentforge_local_only
AGENTFORGE_SERVER_PORT=8080
AGENTFORGE_JWT_SECRET=REPLACE_WITH_BASE64_32_BYTE_RANDOM_VALUE
AGENTFORGE_JWT_ISSUER=https://agentforge.local/core-api
AGENTFORGE_JWT_TTL=PT30M
AGENTFORGE_REGISTRATION_ENABLED=true
AGENTFORGE_AI_DAILY_LIMIT=0

AGENTFORGE_AGENT_SERVICE_URL=http://localhost:8000
AGENTFORGE_AGENT_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN
AGENTFORGE_CORE_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_CORE_INTERNAL_TOKEN
AGENTFORGE_AGENT_CONNECT_TIMEOUT=PT2S
AGENTFORGE_AGENT_READ_TIMEOUT=PT30S
AGENTFORGE_AGENT_CORE_API_URL=http://localhost:8080
AGENTFORGE_AGENT_RAG_DB_DSN=postgresql://agentforge:agentforge_local_only@localhost:5432/agentforge
AGENTFORGE_AGENT_EMBEDDING_PROVIDER=hash
AGENTFORGE_AGENT_EMBEDDING_DIMENSIONS=384
AGENTFORGE_AGENT_LLM_PROVIDER=disabled
AGENTFORGE_AGENT_LLM_API_KEY=
# Optional overrides for the selected provider; leave blank to use documented defaults.
AGENTFORGE_AGENT_LLM_BASE_URL=
AGENTFORGE_AGENT_LLM_MODEL=
AGENTFORGE_AGENT_LLM_MAX_TOKENS=800
