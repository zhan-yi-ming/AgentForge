AGENTFORGE_JWT_SECRET=REPLACE_WITH_BASE64_32_BYTE_RANDOM_VALUE
AGENTFORGE_JWT_ISSUER=https://203.0.113.10/core-api
AGENTFORGE_JWT_TTL=PT30M
AGENTFORGE_AGENT_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN
AGENTFORGE_CORE_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_CORE_INTERNAL_TOKEN
AGENTFORGE_REGISTRATION_ENABLED=false
AGENTFORGE_AI_DAILY_LIMIT=30
